<Window x:Class="CharacterMap.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:CharacterMap.Wpf.Controls"
 Title="Character Map" Icon="Assets/CharacterMap.ico" Width="1440" Height="920" MinWidth="960" MinHeight="620"
 FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
 WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown" AllowDrop="True" Drop="Window_Drop">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/></WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="22"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource TabBarBrush}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
    <Button x:Name="MenuButton" Content="&#xE700;" HorizontalAlignment="Left" Width="44" Style="{StaticResource IconButton}" Click="Menu_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="菜单" AutomationProperties.Name="菜单"/>
    <DockPanel Grid.Column="1">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE710;" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Command="{Binding AddTabCommand}" ToolTip="新标签页 (Ctrl+T)" AutomationProperties.Name="新标签页"/></StackPanel>
     <c:ExtendedTabView ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" AutomationProperties.Name="字体标签页"/>
    </DockPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="&#xE921;" Width="46" Style="{StaticResource IconButton}" FontSize="11" Click="Minimize_Click" AutomationProperties.Name="最小化"/>
     <Button Content="&#xE922;" Width="46" Style="{StaticResource IconButton}" FontSize="11" Click="Maximize_Click" AutomationProperties.Name="最大化或还原"/>
     <Button Content="&#xE8BB;" Width="46" Style="{StaticResource IconButton}" FontSize="12" Click="Close_Click" AutomationProperties.Name="关闭"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
     <StackPanel Margin="18,12,14,10"><TextBlock Text="所有字体" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding FontCountLabel}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
     <c:SuggestionBox x:Name="FontSearchBox" Grid.Row="1" PlaceholderText="查找字体家族" Background="Transparent" Text="{Binding FontSearch, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,6" AutomationProperties.Name="查找字体家族"/>
     <c:ExtendedListView x:Name="FontList" Grid.Row="2" ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" AutomationProperties.Name="字体家族">
      <c:ExtendedListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Margin="18,12,18,6" Padding="0,0,0,8"><TextBlock Text="{Binding Name}" FontSize="28" Foreground="{DynamicResource TextBrush}"/></Border>
      </DataTemplate></GroupStyle.HeaderTemplate><GroupStyle.Panel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></c:ExtendedListView.GroupStyle>
     </c:ExtendedListView>
     <DockPanel Grid.Row="3" Margin="8,0"><Button DockPanel.Dock="Right" Content="&#xE76B;" Style="{StaticResource IconButton}" Click="Sidebar_Click" ToolTip="收起字体列表" AutomationProperties.Name="收起字体列表"/><Button Content="&#xE8F1;" HorizontalAlignment="Left" Style="{StaticResource IconButton}" Click="Compare_Click" ToolTip="对比字体" AutomationProperties.Name="对比字体"/></DockPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="20,10,18,0">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="350"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding SelectedFont.DisplayName}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <c:SuggestionBox x:Name="GlyphSearchBox" Grid.Column="1" Text="{Binding CodePointSearch, UpdateSourceTrigger=PropertyChanged}" QueryCommand="{Binding FindCodePointCommand}" PlaceholderText="搜索字符、Unicode 名称或 16 进制序号" AutomationProperties.Name="搜索字符、Unicode 名称或码点"/>
     <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,7,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="240"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <c:ButtonGroup VerticalAlignment="Center">
      <Button Content="&#xE80A;" Style="{StaticResource IconButton}" Click="GridMode_Click" ToolTip="字符网格" AutomationProperties.Name="字符网格"/>
      <Button Content="&#xE8D2;" Style="{StaticResource IconButton}" Click="Annotation_Click" ToolTip="显示 Unicode 标注" AutomationProperties.Name="显示 Unicode 标注"/>
      <Button Content="&#xE8A4;" Style="{StaticResource IconButton}" Click="ListMode_Click" ToolTip="字符详情列表" AutomationProperties.Name="字符详情列表"/>
     </c:ButtonGroup>
     <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE946;" Style="{StaticResource IconButton}" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Click="Info_Click" ToolTip="字体信息" AutomationProperties.Name="字体信息"/><Button x:Name="FilterButton" Content="&#xE71C;" Style="{StaticResource IconButton}" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Click="Filter_Click" ToolTip="筛选 Unicode 区段" AutomationProperties.Name="筛选 Unicode 区段"/></StackPanel>
       <StackPanel Margin="8,0,2,0"><ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Name" FontSize="12" Padding="3,0" BorderThickness="0" Background="Transparent" MinHeight="20" AutomationProperties.Name="字体变体"/><TextBlock Text="{Binding GlyphCountLabel}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
      </DockPanel>
     </Border>
     <Button Grid.Column="4" Content="&#xE712;" Style="{StaticResource IconButton}" Click="More_Click" ToolTip="字符显示选项" AutomationProperties.Name="字符显示选项"/>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="6"/><ColumnDefinition Width="0.56*" MinWidth="230"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="112"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding CurrentBlockLabel}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
      <c:CharacterGridView x:Name="CharacterGrid" Grid.Row="1" ItemsSource="{Binding Glyphs}" SelectedItem="{Binding SelectedGlyph}" ItemFontFace="{Binding CurrentFace}" ItemSize="{Binding ItemSize}" FontSize="36" ShowAnnotations="{Binding ShowAnnotations}" ItemDoubleClickCommand="{Binding AddCommand}" AutomationProperties.Name="字符网格"/>
      <ListBox x:Name="CharacterList" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding Glyphs}" SelectedItem="{Binding SelectedGlyph}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="CharacterList_DoubleClick" AutomationProperties.Name="字符详情列表">
       <ListBox.ItemTemplate><DataTemplate><Grid Height="62"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <c:DirectText CodePoint="{Binding CodePoint}" GlyphTypeface="{Binding DataContext.CurrentFace, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextBrush}" FontSize="32"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12"/></StackPanel>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="没有匹配的字符" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Glyphs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{Binding SelectedFont.Family}" FontWeight="{Binding SelectedVariant.Weight}" FontStyle="{Binding SelectedVariant.Style}" FontStretch="{Binding SelectedVariant.Stretch}" FontSize="28" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="字符编辑区"/>
       <TextBlock Text="双击某个字符或点击“添加”按钮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ComposerText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="＋  添加" Style="{StaticResource QuietButton}" Command="{Binding AddCommand}"/><Button Content="▢  复制" Style="{StaticResource QuietButton}" Command="{Binding CopyTextCommand}"/><Button Content="⌫  清除" Style="{StaticResource QuietButton}" Command="{Binding ClearTextCommand}"/></StackPanel>
      </Grid>
     </Grid>
     <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" ToolTip="调整预览宽度"/>
     <Grid Grid.Column="2" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="54"/></Grid.RowDefinitions>
      <c:DirectText x:Name="GlyphPreview" GlyphTypeface="{Binding CurrentFace}" CodePoint="{Binding SelectedGlyph.CodePoint, FallbackValue=0}" FitToBounds="True" Foreground="{DynamicResource TextBrush}" Padding="24,65,24,65" AutomationProperties.Name="所选字符预览"/>
      <StackPanel Grid.Row="1" Margin="8,10"><TextBlock Text="{Binding FontSupportSummary}" ToolTip="{Binding FontSupportNotice}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Text="{Binding SelectedGlyph.Name}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedGlyph.Code}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Text="{Binding SelectedGlyph.Block}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
      <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="Tools_Click"><StackPanel><TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="工具" FontSize="11"/></StackPanel></Button><Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="Export_Click"><StackPanel><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="另存为" FontSize="11"/></StackPanel></Button><Button HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Command="{Binding CopyCommand}"><StackPanel><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="复制" FontSize="11"/></StackPanel></Button></DockPanel>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Background="{DynamicResource PageBrush}" Margin="12,0"><ProgressBar DockPanel.Dock="Right" Width="100" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
  <Popup x:Name="AppMenu" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Width="465" Padding="16">
    <StackPanel><TextBlock Text="打开" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
     <c:ButtonGroup Orientation="Vertical"><c:LabelButton Title="打开字体文件" Description="打开 TTF、OTF、TTC、OTC、WOFF 文件" Shortcut="Ctrl+O" Icon="&#xE8E5;" Click="OpenFont_Click"/><c:LabelButton Title="打开字体文件夹" Description="打开文件夹及其子目录中的字体文件" Shortcut="Ctrl+Shift+O" Icon="&#xE8B7;" Click="OpenFolder_Click"/></c:ButtonGroup>
     <TextBlock Text="更多操作" FontSize="16" Margin="0,16,0,8" Foreground="{DynamicResource TextBrush}"/>
     <c:ButtonGroup Orientation="Vertical"><c:LabelButton Title="对比字体" Description="使用同一段文字并排对比字体" Shortcut="Ctrl+K" Icon="&#xE8F1;" Click="Compare_Click"/><c:LabelButton Title="书法" Description="以当前字体为底稿练习书写" Shortcut="Ctrl+I" Icon="&#xEDFB;" Click="Calligraphy_Click"/></c:ButtonGroup>
     <UniformGrid Columns="4" Margin="0,8,0,0"><Button Content="全屏 F11" Style="{StaticResource QuietButton}" Click="Fullscreen_Click"/><Button Content="打印" Style="{StaticResource QuietButton}" Click="Print_Click"/><Button Content="设置" Style="{StaticResource QuietButton}" Click="Settings_Click"/><Button Content="关于" Style="{StaticResource QuietButton}" Click="About_Click"/></UniformGrid>
     <Button Content="显示 / 隐藏字体列表" Style="{StaticResource QuietButton}" Click="Sidebar_Click" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
  </Popup>
  <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="330"><StackPanel><TextBlock Text="Unicode 区段" Foreground="{DynamicResource TextBrush}" FontSize="16" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}" DisplayMemberPath="Name" AutomationProperties.Name="Unicode 区段"/><CheckBox Content="显示字符码点" IsChecked="{Binding ShowAnnotations}" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="字符大小" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,8"/><Slider Minimum="56" Maximum="160" Value="{Binding ItemSize}" AutomationProperties.Name="字符大小"/></StackPanel></Border>
  </Popup>
 </Grid>
</Window>
