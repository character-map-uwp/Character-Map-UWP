<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CharacterMapCX.Controls">

    <!--<controls:GlyphBoundsOptions
        x:Key="DefaultGlyphBoundsOptions"
        AdvanceBoundsBrush="#80808080"
        AscentBrush="#FF107C10"
        BaselineBrush="#FFE05286"
        CapHeightBrush="#FF3B82F6"
        DescentBrush="#FFF28C38"
        DrawLinesOverGlyph="True"
        InkBoundsBrush="#80E81123"
        LineThickness="1.5"
        ShowAdvanceBounds="False"
        ShowAscent="True"
        ShowBaseline="True"
        ShowCapHeight="True"
        ShowDescent="True"
        ShowInkBounds="False"
        ShowXHeight="False"
        XHeightBrush="#FF00B7C3" />-->

    <Style TargetType="controls:DirectText">
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <!--<Setter Property="GlyphBoundsOptions" Value="{StaticResource DefaultGlyphBoundsOptions}" />-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DirectText">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DirectTextBox">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DirectTextBox">
                    <Border
                        x:Name="RootElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="RootElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushDisabled}" />
                                        <Setter Target="RootElement.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="HitContainer" Background="Transparent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
